        "day2": "Database Integration & User Context",
        "day3": "Chat History & Retrieval",
        "day4": "Authentication Layer",
        "day5": "AI Logic & Model Configuration",
        "day6": "Document Ingestion / RAG Pipeline",
        "day7": "Moderation + Analytics",
        "day8": "Deployment + Monitoring"
    }
}