{
    "version": "1.0.0",
    "environment": "production",
    "backend_url": "https://ai-chatbox-backend.onrender.com",
    "frontend_url": "https://ai-chatbox.vercel.app",
    "deployment_platforms": {
        "recommended": [
            "Render",
            "Railway",
            "Heroku"
        ],
        "database": [
            "PostgreSQL",
            "Supabase"
        ],
        "vector_db": [
            "Pinecone",
            "pgvector"
        ]
    },
    "environment_variables": {
